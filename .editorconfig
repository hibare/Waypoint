# Managed by Axon; manual edits will be overwritten.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[{Makefile,GNUmakefile,*.mk}]
indent_style = tab

[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue}]
indent_size = 2

[*.{json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[Dockerfile*]
indent_size = 4

[*.sql]
indent_size = 4

[.git*]
trim_trailing_whitespace = false
